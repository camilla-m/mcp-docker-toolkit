{
  "mcpServers": {
    "docker-mcp-gateway": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--init",
        "-v",
        "/var/run/docker.sock:/var/run/docker.sock",
        "docker/mcp-gateway:latest",
        "--servers=duckduckgo,time"
      ]
    }
  }
}
